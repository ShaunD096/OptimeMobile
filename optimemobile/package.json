    "db:seed": "tsx prisma/seed.ts",
    "fetch-weather-data": "node scripts/fetch-weather-100.mjs",
    "fetch-airports": "node scripts/fetch-airports.mjs",
    "export-engine": "node scripts/export-engine.mjs",
    "generate-plaid-training-dataset": "tsx scripts/generate-plaid-training-dataset.ts",
    "generate:worked-calculations": "tsx scripts/generate-worked-calculations.mts",
    "dev:local": "node scripts/dev-local.mjs",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@gsap/react": "^2.1.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.22.0",
    "plaid": "^45.0.0",
    "prisma": "^7.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-plaid-link": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
