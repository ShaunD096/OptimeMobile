  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "better-sqlite3@12.11.1": true,
    "@prisma/engines@7.9.1": true,
    "prisma@7.9.1": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
